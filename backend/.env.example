# Borewell Visualizer Backend Configuration
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_PORT=8080

# Database
# PostgreSQL connection URL (required)
# Example: postgresql://user:password@localhost:5432/borewell?sslmode=disable
DATABASE_URL=

# Optional: Separate URL for migrations (if different from DATABASE_URL)
# MIGRATION_DATABASE_URL=

# Database connection pool settings
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_MAX_LIFETIME=1h
DATABASE_MAX_IDLE_TIME=30m

# Logging
LOG_LEVEL=info

# File Storage
# Directory where uploaded files will be stored (relative to backend directory or absolute)
FILE_STORAGE_PATH=./data/files

# JWT Configuration (REQUIRED - must be set)
# Use strong random strings (32+ characters) in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production-min-32-chars

# Argon2 Password Hashing Parameters
# Time: number of iterations (higher = more secure, slower)
ARGON2_TIME=3
# Memory: memory usage in KB (higher = more secure, more memory)
ARGON2_MEMORY=65536
# Threads: parallelism degree
ARGON2_THREADS=4
# KeyLen: output key length in bytes
ARGON2_KEYLEN=32